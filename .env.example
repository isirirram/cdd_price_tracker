
# Smart Price Tracker - Root Environment Configuration
# Copy this file to .env and fill in what you need. Never commit .env.

# Backend / MongoDB
MONGO_URI=mongodb://mongo:27017/price_tracker

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# How often Celery Beat re-checks every product (seconds). 300 = 5 minutes,
# so alerts arrive within a few minutes of a price drop. Use 60 for a live demo.
# Minimum 30. robots.txt and Crawl-delay are always respected.
CHECK_INTERVAL_SECONDS=300

# Frontend API
VITE_API_URL=http://localhost:8000

# Extra allowed frontend origins, comma-separated (e.g. another laptop on the LAN)
CORS_ORIGINS=

# Scraper - Open Prices
OPEN_PRICES_USER_AGENT=SmartPriceTracker/1.0 (CollegeProject; contact: student@example.edu)

# Scraper - Local Demo Store
LOCAL_STORE_URL=http://127.0.0.1:8001

# Email alerts (price drop notifications)
# Gmail: turn on 2-Step Verification, then create an App Password and use it
# as SMTP_PASSWORD (your normal Gmail password will NOT work).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM_EMAIL=
# Used when a product was added without its own alert email
ALERT_EMAIL_TO=

# Telegram alerts (optional, can be used together with email)
# 1. In Telegram, message @BotFather -> /newbot -> copy the token below.
# 2. Send any message to your new bot, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id":...}
TELEGRAM_BOT_TOKEN=
# Used when a product was added without its own Telegram chat id
TELEGRAM_CHAT_ID=

# AI price assistant (chat widget). Leave LLM_API_KEY empty to use the
# built-in offline assistant (rule-based, no internet needed).
# Default provider is Groq (free key at https://console.groq.com/keys).
# Any OpenAI-compatible API works by changing LLM_BASE_URL and LLM_MODEL.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
