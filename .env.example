
# Smart Price Tracker - Root Environment Configuration

# Backend / MongoDB
MONGO_URI=mongodb://mongo:27017/price_tracker

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# Frontend API
VITE_API_URL=http://localhost:8000

# Scraper - Open Prices
OPEN_PRICES_USER_AGENT=SmartPriceTracker/1.0 (CollegeProject; contact: student@example.edu)

# Scraper - Local Demo Store
LOCAL_STORE_URL=http://127.0.0.1:8001

# Optional Amazon API credentials
AMAZON_CREDENTIAL_ID=
AMAZON_CREDENTIAL_SECRET=
AMAZON_PARTNER_TAG=

# Optional Flipkart API credentials
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=

# Email notifications (price-drop alerts, sent by the worker)
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, and SMTP_PASSWORD must be
# a 16-character App Password (Google Account > Security > App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# "From" address; defaults to SMTP_USER if empty
ALERT_FROM_EMAIL=
# Fallback recipient for products added without a notify_email
ALERT_EMAIL_TO=
